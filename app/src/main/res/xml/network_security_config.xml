<?xml version="1.0" encoding="utf-8"?>
<!-- Solo HTTPS e solo certificati di sistema: niente traffico in chiaro,
     niente CA installate dall'utente (protezione da intercettazioni). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
